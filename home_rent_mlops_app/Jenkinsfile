// =========================================================
// Jenkinsfile - Home Rent Prediction MLOps Pipeline
// =========================================================
// Runs on a Linux (Ubuntu) Jenkins agent with Python 3.11 and
// Docker installed. Implements the full flow:
//
//   Checkout -> Install Deps -> Data Validation -> Train Model
//   -> Unit Tests -> Docker Build -> Docker Deploy
// =========================================================

pipeline {
    agent any

    environment {
        PYTHON_ENV       = "venv"
        IMAGE_NAME        = "home-rent-mlops-app"
        IMAGE_TAG          = "${env.BUILD_NUMBER}"
        CONTAINER_NAME      = "home_rent_app"
        APP_PORT             = "5000"
        MLFLOW_TRACKING_URI = "file://${WORKSPACE}/mlruns"
    }

    options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
    disableConcurrentBuilds()
    }

    stages {

        stage('1. Checkout Source Code') {
            steps {
                echo "Checking out source code from GitHub..."
                checkout scm
            }
        }

        stage('2. Install Dependencies') {
            steps {
                echo "Creating virtual environment and installing dependencies..."
                sh '''
                    python3 -m venv ${PYTHON_ENV}
                    . ${PYTHON_ENV}/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                '''
            }
        }

        stage('3. Run Data Validation') {
            steps {
                echo "Generating dataset (if needed) and running data validation..."
                sh '''
                    . ${PYTHON_ENV}/bin/activate
                    python src/generate_data.py
                    python src/data_validation.py
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'data/validation_report.json', allowEmptyArchive: true
                }
            }
        }

        stage('4. Train ML Model') {
            steps {
                echo "Training candidate models and logging to MLflow..."
                sh '''
                    . ${PYTHON_ENV}/bin/activate
                    export MLFLOW_TRACKING_URI=${MLFLOW_TRACKING_URI}
                    python src/train.py
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'models/*.joblib,models/model_metadata.json', allowEmptyArchive: true
                }
            }
        }

        stage('5. Run Unit Tests') {
            steps {
                echo "Running pytest unit test suite..."
                sh '''
                    . ${PYTHON_ENV}/bin/activate
                    pytest --junitxml=test-results.xml --cov=src --cov=app tests/
                '''
            }
            post {
                always {
                    junit 'test-results.xml'
                }
            }
        }

        stage('6. Build Docker Image') {
            steps {
                echo "Building Docker image ${IMAGE_NAME}:${IMAGE_TAG}..."
                sh '''
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:latest .
                '''
            }
        }

        stage('7. Deploy Docker Container') {
            steps {
                echo "Deploying container on port ${APP_PORT}..."
                sh '''
                    docker stop ${CONTAINER_NAME} || true
                    docker rm ${CONTAINER_NAME} || true
                    docker run -d \
                        --name ${CONTAINER_NAME} \
                        -p ${APP_PORT}:5000 \
                        --restart unless-stopped \
                        ${IMAGE_NAME}:latest
                '''
            }
        }

        stage('8. Smoke Test Deployment') {
            steps {
                echo "Waiting for container to become healthy, then hitting /health..."
                sh '''
                    sleep 10
                    curl --fail http://localhost:${APP_PORT}/health || (docker logs ${CONTAINER_NAME} && exit 1)
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline completed successfully. App is live on port ${APP_PORT}."
        }
        failure {
            echo "❌ Pipeline failed. Check the stage logs above."
        }
        always {
            sh 'deactivate || true'
        }
    }
}
