// =========================================================
// Jenkinsfile - Home Rent Prediction MLOps Pipeline
// =========================================================

pipeline {
    agent any

    environment {
        PROJECT_DIR = "home_rent_mlops_app"
        PYTHON_ENV = "venv"
        IMAGE_NAME = "home-rent-mlops-app"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        CONTAINER_NAME = "home_rent_app"
        APP_PORT = "5000"
        MLFLOW_TRACKING_URI = "file://${WORKSPACE}/${PROJECT_DIR}/mlruns"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {

        stage('1. Checkout Source Code') {
            steps {
                echo "Checking out source code from GitHub..."
                checkout scm
            }
        }

        stage('2. Install Dependencies') {
            steps {
                echo "Creating virtual environment and installing dependencies..."
                sh '''
                    cd ${PROJECT_DIR}
                    python3 -m venv ${PYTHON_ENV}
                    . ${PYTHON_ENV}/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                '''
            }
        }

        stage('3. Run Data Validation') {
            steps {
                echo "Generating dataset and running data validation..."
                sh '''
                    cd ${PROJECT_DIR}
                    . ${PYTHON_ENV}/bin/activate
                    python src/generate_data.py
                    python src/data_validation.py
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: "${PROJECT_DIR}/data/validation_report.json", allowEmptyArchive: true
                }
            }
        }

        stage('4. Train ML Model') {
            steps {
                echo "Training ML model..."
                sh '''
                    cd ${PROJECT_DIR}
                    . ${PYTHON_ENV}/bin/activate
                    export MLFLOW_TRACKING_URI=${MLFLOW_TRACKING_URI}
                    python src/train.py
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: "${PROJECT_DIR}/models/*.joblib,${PROJECT_DIR}/models/model_metadata.json", allowEmptyArchive: true
                }
            }
        }

        stage('5. Run Unit Tests') {
            steps {
                echo "Running unit tests..."
                sh '''
                    cd ${PROJECT_DIR}
                    . ${PYTHON_ENV}/bin/activate
                    pytest --junitxml=test-results.xml --cov=src --cov=app tests/
                '''
            }
            post {
                always {
                    junit "${PROJECT_DIR}/test-results.xml"
                }
            }
        }

        stage('6. Build Docker Image') {
            steps {
                echo "Building Docker image..."
                sh '''
                    cd ${PROJECT_DIR}
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:latest .
                '''
            }
        }

        stage('7. Deploy Docker Container') {
            steps {
                echo "Deploying Docker container..."
                sh '''
                    docker stop ${CONTAINER_NAME} || true
                    docker rm ${CONTAINER_NAME} || true

                    docker run -d \
                        --name ${CONTAINER_NAME} \
                        -p ${APP_PORT}:5000 \
                        ${IMAGE_NAME}:latest
                '''
            }
        }

        stage('8. Health Check') {
            steps {
                echo "Checking application health..."
                sh '''
                    sleep 5
                    curl -f http://localhost:${APP_PORT}/health
                '''
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully!"
        }

        failure {
            echo "Pipeline failed. Please check console output."
        }

        always {
            echo "Pipeline execution finished."
        }
    }
}